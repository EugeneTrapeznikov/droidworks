+    #[test]
+    fn disables_then_re_enables_in_separate_steps() {
+        let start = Instant::now();
+        let mut rearm = FocusRearm::new(start);
+
+        assert_eq!(rearm.poll(start), None);
+        assert_eq!(rearm.delay(start), FOCUS_REARM_PERIOD);
+        assert_eq!(
+            rearm.poll(start + FOCUS_REARM_PERIOD),
+            Some(&b"\x1b[?1004l"[..])
+        );
+        assert_eq!(rearm.poll(start + FOCUS_REARM_PERIOD), None);
+        assert_eq!(rearm.delay(start + FOCUS_REARM_PERIOD), FOCUS_REARM_GAP);
+        assert_eq!(
+            rearm.poll(start + FOCUS_REARM_PERIOD + FOCUS_REARM_GAP),
+            Some(&b"\x1b[?1004h"[..])
+        );
+        assert_eq!(
+            rearm.delay(start + FOCUS_REARM_PERIOD + FOCUS_REARM_GAP),
+            FOCUS_REARM_PERIOD
+        );
+    }
 }
