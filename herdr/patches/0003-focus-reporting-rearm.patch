+// Periodically re-arms host focus reporting (mode 1004).
+//
+// Some hosts (Orca) silently drop focus reporting, and a plain `?1004h` re-assert
+// never reaches them through Mosh: Mosh forwards a mode only when its own copy
+// changes. Disabling and re-enabling in separate Mosh frames forwards both, and
+// the host answers the enable with its current focus state.
+
+const FOCUS_REARM_PERIOD: Duration = Duration::from_secs(10);
+// Longer than Mosh's maximum frame interval, so the two writes land in separate frames.
+const FOCUS_REARM_GAP: Duration = Duration::from_millis(500);
+
+pub(super) struct FocusRearm {
+    next: Instant,
+    disabled: bool,
+}
+
+impl FocusRearm {
+    pub(super) fn new(now: Instant) -> Self {
+        Self {
+            next: now + FOCUS_REARM_PERIOD,
+            disabled: false,
+        }
+    }
+
+    /// Bytes to write to the host when the next step is due.
+    pub(super) fn poll(&mut self, now: Instant) -> Option<&'static [u8]> {
+        if now < self.next {
+            return None;
+        }
+        self.disabled = !self.disabled;
+        self.next = now
+            + if self.disabled {
+                FOCUS_REARM_GAP
+            } else {
+                FOCUS_REARM_PERIOD
+            };
+        Some(if self.disabled {
+            b"\x1b[?1004l"
+        } else {
+            b"\x1b[?1004h"
+        })
+    }
+
+    pub(super) fn delay(&self, now: Instant) -> Duration {
+        self.next.saturating_duration_since(now)
+    }
+}
+
