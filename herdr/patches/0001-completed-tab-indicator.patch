 use super::*;
 
+#[test]
+fn only_unfocused_done_tabs_render_an_accent_completion_dot() {
+    let mut snapshot = snapshot();
+    snapshot.tabs[0].agent_status = AgentStatus::Done;
+    snapshot.tabs.push(ClientShellTab {
+        tab_id: "tab_2".into(),
+        workspace_id: "ws_1".into(),
+        number: 2,
+        label: "completed".into(),
+        custom_label: true,
+        zoomed: false,
+        focused: false,
+        agent_status: AgentStatus::Done,
+    });
+    snapshot.tabs.extend(
+        [
+            AgentStatus::Idle,
+            AgentStatus::Working,
+            AgentStatus::Blocked,
+            AgentStatus::Unknown,
+        ]
+        .into_iter()
+        .enumerate()
+        .map(|(index, agent_status)| ClientShellTab {
+            tab_id: format!("tab_{}", index + 3),
+            workspace_id: "ws_1".into(),
+            number: index + 3,
+            label: format!("other-{}", index + 3),
+            custom_label: true,
+            zoomed: false,
+            focused: false,
+            agent_status,
+        }),
+    );
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(snapshot));
+    state.set_pane_surface(surface());
+
+    let frame = state.compose(106, 20).expect("completion tab frame");
+    let buffer = frame.to_ratatui_buffer().expect("frame should reconstruct");
+    let focused = state
+        .hits
+        .tabs
+        .iter()
+        .find(|(_, tab_id)| tab_id == "tab_1")
+        .expect("focused tab")
+        .0;
+    let completed = state
+        .hits
+        .tabs
+        .iter()
+        .find(|(_, tab_id)| tab_id == "tab_2")
+        .expect("completed tab")
+        .0;
+    let focused_dots = (focused.x..focused.right())
+        .filter(|x| buffer[(*x, focused.y)].symbol() == "●")
+        .count();
+    let completed_dots = (completed.x..completed.right())
+        .filter(|x| buffer[(*x, completed.y)].symbol() == "●")
+        .collect::<Vec<_>>();
+
+    assert_eq!(focused_dots, 0);
+    assert_eq!(completed_dots.len(), 1);
+    assert_eq!(
+        buffer[(completed_dots[0], completed.y)].fg,
+        state.config.palette.accent
+    );
+    for tab_id in ["tab_3", "tab_4", "tab_5", "tab_6"] {
+        let rect = state
+            .hits
+            .tabs
+            .iter()
+            .find(|(_, candidate)| candidate == tab_id)
+            .expect("non-completed tab")
+            .0;
+        assert!((rect.x..rect.right()).all(|x| buffer[(x, rect.y)].symbol() != "●"));
+    }
+}
