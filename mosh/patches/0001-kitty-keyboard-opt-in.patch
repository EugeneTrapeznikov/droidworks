diff --git a/src/terminal/terminaldisplay.cc b/src/terminal/terminaldisplay.cc
index e7595c2..dba4453 100644
--- a/src/terminal/terminaldisplay.cc
+++ b/src/terminal/terminaldisplay.cc
@@ -47,15 +47,25 @@ static const Renditions & initial_rendition( void )
 
 std::string Display::open() const
 {
-  return std::string( smcup ? smcup : "" ) + std::string( "\033[?1h" );
+  std::string result = std::string( smcup ? smcup : "" ) + std::string( "\033[?1h" );
+  if ( kitty_keyboard && !kitty_keyboard_active ) {
+    result.append( "\033[>7u" );
+    kitty_keyboard_active = true;
+  }
+  return result;
 }
 
 std::string Display::close() const
 {
-  return std::string( "\033[?1l\033[0m\033[?25h"
-		      "\033[?1003l\033[?1002l\033[?1001l\033[?1000l"
-		      "\033[?1015l\033[?1006l\033[?1005l" ) +
-    std::string( rmcup ? rmcup : "" );
+  std::string result( "\033[?1l\033[0m\033[?25h"
+                      "\033[?1003l\033[?1002l\033[?1001l\033[?1000l"
+                      "\033[?1015l\033[?1006l\033[?1005l" );
+  if ( kitty_keyboard && kitty_keyboard_active ) {
+    result.append( "\033[<u" );
+    kitty_keyboard_active = false;
+  }
+  result.append( rmcup ? rmcup : "" );
+  return result;
 }
 
 std::string Display::new_frame( bool initialized, const Framebuffer &last, const Framebuffer &f ) const
@@ -336,6 +346,13 @@ std::string Display::new_frame( bool initialized, const Framebuffer &last, const
     }
   }
 
+  /* The outer terminal can reset its keyboard mode without telling us, so
+     every frame that draws sets the Kitty flags again; a remote selection
+     draws before the copy key arrives. Set, not push: the stack stays flat. */
+  if ( kitty_keyboard && kitty_keyboard_active && !frame.str.empty() ) {
+    frame.append( "\033[=7u" );
+  }
+
   return frame.str;
 }
 
