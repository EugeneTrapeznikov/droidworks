+/// Returns whether the active screen can encode modified printable keys.
+pub fn usesKittyKeyboardDisambiguation(self: *const Surface) bool {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    return self.io.terminal.screens.active.kitty_keyboard.current().disambiguate;
+}
