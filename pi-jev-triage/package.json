    "directory": "pi-jev-triage"
  },
  "homepage": "https://github.com/EugeneTrapeznikov/droidworks/tree/main/pi-jev-triage",
  "type": "module",
  "files": ["extension/src/**/*.ts", "README.md", "LICENSE"],
  "pi": {
    "extensions": ["./extension/src/index.ts"]
